# Production Database Configuration (AWS RDS PostgreSQL / Azure Database for PostgreSQL)
DB_CONNECTION_STRING="Host=prod-db.example.com;Port=5432;Database=theagency_prod;Username=theagency_admin;Password=REPLACE_WITH_STRONG_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=100;"

# Production Redis Cluster Configuration
REDIS_CONNECTION_STRING="prod-redis.example.com:6379,password=REPLACE_WITH_REDIS_PASSWORD,ssl=true"

# Production RabbitMQ Cluster Configuration
RABBITMQ_HOST="prod-rabbitmq.example.com"
RABBITMQ_PORT="5671"
RABBITMQ_USERNAME="theagency_prod"
RABBITMQ_PASSWORD="REPLACE_WITH_RABBITMQ_PASSWORD"

# Production S3 Storage (AWS S3)
S3_SERVICE_URL="https://s3.us-east-1.amazonaws.com"
S3_BUCKET_NAME="theagency-production-assets"
AWS_ACCESS_KEY_ID="REPLACE_WITH_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="REPLACE_WITH_AWS_SECRET_KEY"

# Production JWT Secret & Authentication (MUST BE >= 32 CHARS AND NON-DEFAULT)
JWT_SECRET="REPLACE_WITH_SECURE_RANDOM_256BIT_SECRET_STRING_MIN32_CHARS"
JWT_ISSUER="TheAgency.Production"
JWT_AUDIENCE="TheAgency.App"
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Production OpenTelemetry & Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT="https://otel-collector.example.com:4317"
PROMETHEUS_METRICS_ENABLED="true"

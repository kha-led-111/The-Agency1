{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Messaging": {
    "Enabled": true
  },
  "Identity": {
    "ReturnEmailTokensInResponses": false,
    "EmailVerificationExpirationHours": 24,
    "PasswordResetExpirationHours": 1,
    "AuthRateLimitPermit": 10,
    "AuthRateLimitWindowMinutes": 1
  }
}

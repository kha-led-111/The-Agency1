# Build Stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy Solution & Project Files
COPY backend/TheAgency.sln ./
COPY backend/src/TheAgency.Domain/TheAgency.Domain.csproj src/TheAgency.Domain/
COPY backend/src/TheAgency.Application/TheAgency.Application.csproj src/TheAgency.Application/
COPY backend/src/TheAgency.Infrastructure/TheAgency.Infrastructure.csproj src/TheAgency.Infrastructure/
COPY backend/src/TheAgency.API/TheAgency.API.csproj src/TheAgency.API/
COPY backend/tests/TheAgency.Tests.Unit/TheAgency.Tests.Unit.csproj tests/TheAgency.Tests.Unit/
COPY backend/tests/TheAgency.Tests.Integration/TheAgency.Tests.Integration.csproj tests/TheAgency.Tests.Integration/

# Restore Dependencies
RUN dotnet restore TheAgency.sln

# Copy Source Code
COPY backend/src/ ./src/
COPY backend/tests/ ./tests/

# Build & Publish Release Output
RUN dotnet publish src/TheAgency.API/TheAgency.API.csproj -c Release -o /app/publish /p:UseAppHost=false

# Runtime Production Stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0-alpine AS runtime
WORKDIR /app

# Security Configuration
RUN addgroup -g 10001 -S appgroup && \
  adduser -u 10001 -S appuser -G appgroup

COPY --from=build /app/publish ./
RUN chown -R appuser:appgroup /app

USER appuser

EXPOSE 8080
ENV ASPNETCORE_URLS="http://+:8080"
ENV ASPNETCORE_ENVIRONMENT="Production"

ENTRYPOINT ["dotnet", "TheAgency.API.dll"]